# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and never committed.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=mparoma

# Order emails: sent to ADMIN_EMAIL whenever a customer places an order.
# For Gmail, use an "App Password" (not your normal password) for SMTP_PASS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM= 
ADMIN_EMAIL=
